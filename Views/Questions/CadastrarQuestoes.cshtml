@{
    ViewData["Title"] = "Cadastrar Questoes";
}

@model MicroSaaSProvas.Models.CreatQuestionsViewModel

<h1>Cadastrar Questão</h1>
<form asp-action="CadastrarQuestoes" asp-controller="Questions" method="post">
    <div class="form-group mb-3">
        <label asp-for="Enunciado" class="form-label">Enunciado</label>
        <textarea asp-for="Enunciado" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Enunciado" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Gabarito" class="form-label">Gabarito</label>
        <input asp-for="Gabarito" type="text" class="form-control" />
        <span asp-validation-for="Gabarito" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Disciplina" class="form-label">Disciplina</label>
        <select asp-for="Disciplina" class="form-select">
            <option value="">Selecione uma disciplina</option>
            <option value="Matematica">Matemática</option>
            <option value="Portugues">Português</option>
            <option value="Historia">História</option>
            <option value="Geografia">Geografia</option>
        </select>
        <span asp-validation-for="Disciplina" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Dificuldade" class="form-label">Dificuldade</label>
        <select asp-for="Dificuldade" class="form-select">
            <option value="">Selecione</option>
            <option value="1">Fácil</option>
            <option value="2">Média</option>
            <option value="3">Difícil</option>
        </select>
        <span asp-validation-for="Dificuldade" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>