@{
    ViewData["Title"] = "Ver Questões";
}

@model List<MicroSaaSProvas.Models.CreatQuestionsViewModel>

<h1>Questões Cadastradas</h1>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Nenhuma questão cadastrada.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Enunciado</th>
                <th>Disciplina</th>
                <th>Dificuldade</th>
                <th>Gabarito</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                var questao = Model[i];
                var enunciadoShort = questao.Enunciado.Length > 60 ? questao.Enunciado.Substring(0, 60) + "..." : questao.Enunciado;

                <tr>
                    <td>
                        <div>
                            <a class="collapsed"
                               data-bs-toggle="collapse"
                               href="#enunciado-collapse-@i"
                               role="button"
                               aria-expanded="false"
                               aria-controls="enunciado-collapse-@i"
                               style="text-decoration: none; color: inherit;">
                                <span 
                                    style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block; max-width: 260px;">
                                    @enunciadoShort
                                </span>
                                @if (questao.Enunciado.Length > 60)
                                {
                                    <span id="arrow-icon-@i" class="ms-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" 
                                            class="bi bi-chevron-down" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                                        </svg>
                                    </span>
                                }
                            </a>
                        </div>
                        <div class="collapse mt-2" id="enunciado-collapse-@i">
                            <div class="card card-body p-2">
                                @questao.Enunciado
                                <a class="d-block mt-2" href="#"
                                    onclick="var coll = document.getElementById('enunciado-collapse-@i'); var bsCollapse = bootstrap.Collapse.getOrCreateInstance(coll); bsCollapse.hide(); return false;">
                                    <small><span style="vertical-align: middle;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" 
                                            class="bi bi-chevron-up" viewBox="0 0 16 16"
                                            style="position: relative; top: -1px;">
                                            <path fill-rule="evenodd" d="M1.646 11.354a.5.5 0 0 1 .708 0L8 5.707l5.646 5.647a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1-.708 0l-6 6a.5.5 0 0 1 0-.708z"/>
                                        </svg>
                                    </span>Ver menos</small>
                                </a>
                            </div>
                        </div>
                    </td>
                    <td>@questao.Disciplina</td>
                    <td>
                        @{
                            string dificuldade = questao.Dificuldade switch {
                                1 => "Fácil",
                                2 => "Média",
                                3 => "Difícil",
                                _ => "Desconhecida"
                            };
                        }
                        @dificuldade
                    </td>
                    <td>@questao.Gabarito</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        // Optionally toggle chevron direction on expand/collapse
        document.addEventListener("DOMContentLoaded", function() {
            // For all accordions in the table
            var count = @Model?.Count ?? 0;
            for(let i=0; i<count; i++) {
                var collapseId = "enunciado-collapse-" + i;
                var iconSpan = document.getElementById("arrow-icon-" + i);
                var collapseEl = document.getElementById(collapseId);

                if (collapseEl && iconSpan) {
                    collapseEl.addEventListener('show.bs.collapse', function() {
                        iconSpan.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" 
                            class="bi bi-chevron-up" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1.646 11.354a.5.5 0 0 1 .708 0L8 5.707l5.646 5.647a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1-.708 0l-6 6a.5.5 0 0 1 0-.708z"/>
                            </svg>`;
                    });
                    collapseEl.addEventListener('hide.bs.collapse', function() {
                        iconSpan.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" 
                            class="bi bi-chevron-down" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                            </svg>`;
                    });
                }
            }
        });
    </script>
}